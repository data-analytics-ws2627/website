    <bpmndi:BPMNPlane id="Plane_analyse-lifecycle" bpmnElement="Collab_analyse-lifecycle">
      <bpmndi:BPMNShape id="Kunde_di" bpmnElement="Kunde" isHorizontal="true"><dc:Bounds x="0" y="0" width="2720" height="70" /></bpmndi:BPMNShape>
