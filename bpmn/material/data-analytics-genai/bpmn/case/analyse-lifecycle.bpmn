<?xml version="1.0" encoding="UTF-8"?>
<!-- Synthetischer Übungsfall des Data-Analytics-Kurses. Fachliches Modell, nicht ausführbar. Getrennte Detailmodelle erläutern die zugeklappten Teilprozesse. -->
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_analyse-lifecycle" targetNamespace="http://kirenz.de/data-analytics-genai" exporter="process-lab" exporterVersion="0.1">
  <bpmn:collaboration id="Collab_analyse-lifecycle">
    <bpmn:participant id="Kunde" name="Auftraggeber" />
    <bpmn:participant id="Service" name="Analyseservice" processRef="Process_Service" />
    <bpmn:messageFlow id="M1" name="Auftrag und Datenpaket" sourceRef="Kunde" targetRef="Start" />
    <bpmn:messageFlow id="M2" name="Begründeter Abbruch" sourceRef="Abbruch" targetRef="Kunde" />
    <bpmn:messageFlow id="M3" name="Pilotbericht" sourceRef="Senden" targetRef="Kunde" />
  </bpmn:collaboration>
  <bpmn:process id="Process_Service" name="Data-Science-Lifecycle für einen Pilotbericht" isExecutable="false">
    <bpmn:laneSet id="LaneSet_analyse-lifecycle">
      <bpmn:lane id="A" name="Analystin oder Analyst">
        <bpmn:flowNodeRef>Start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Frage</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Vorbereiten</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>CodePruefen</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Revision</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Weiter</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Abbruch</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndeAbbruch</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Bericht</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Split</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Senden</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Join</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Ende</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="S" name="Analysesystem">
        <bpmn:flowNodeRef>Daten</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>DatenOK</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndeDaten</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Code</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Auswerten</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Archiv</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="L" name="Analyseleitung">
        <bpmn:flowNodeRef>Bewerten</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Eignung</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="Start" name="Analyseauftrag eingegangen">
      <bpmn:outgoing>F1</bpmn:outgoing>
      <bpmn:messageEventDefinition />
    </bpmn:startEvent>
    <bpmn:userTask id="Frage" name="Frage und Kriterien festhalten">
      <bpmn:documentation>Frage und Kriterien festhalten. Synthetischer Übungsfall; Durchführung gemäß Fallbeschreibung, keine produktive Automatisierung.</bpmn:documentation>
      <bpmn:incoming>F1</bpmn:incoming>
      <bpmn:outgoing>F2</bpmn:outgoing>

      <bpmn:dataOutputAssociation id="A1"><bpmn:targetRef>Auftrag</bpmn:targetRef></bpmn:dataOutputAssociation>
    </bpmn:userTask>
    <bpmn:subProcess id="Daten" name="Datenpaket prüfen und beschaffen">
      <bpmn:documentation>Detaillierung in datenbereitstellung.bpmn. Liefert Status Daten vorhanden oder Auftrag ohne Daten geschlossen. Korrekturanforderung und Schließungsmitteilung liegen im Teilprozess.</bpmn:documentation>
      <bpmn:incoming>F2</bpmn:incoming>
      <bpmn:outgoing>F3</bpmn:outgoing>

      <bpmn:dataOutputAssociation id="A2"><bpmn:targetRef>Paket</bpmn:targetRef></bpmn:dataOutputAssociation>
    </bpmn:subProcess>
    <bpmn:exclusiveGateway id="DatenOK" name="Daten vorhanden?">
      <bpmn:incoming>F3</bpmn:incoming>
      <bpmn:outgoing>F4</bpmn:outgoing>
      <bpmn:outgoing>F5</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="EndeDaten" name="Ohne Daten geschlossen">
      <bpmn:incoming>F4</bpmn:incoming>

    </bpmn:endEvent>
    <bpmn:userTask id="Vorbereiten" name="Daten verstehen und aufbereiten">
      <bpmn:documentation>Daten verstehen und aufbereiten. Synthetischer Übungsfall; Durchführung gemäß Fallbeschreibung, keine produktive Automatisierung.</bpmn:documentation>
      <bpmn:incoming>F5</bpmn:incoming>
      <bpmn:incoming>F14</bpmn:incoming>
      <bpmn:outgoing>F6</bpmn:outgoing>

    </bpmn:userTask>
    <bpmn:serviceTask id="Code" name="Modellcode entwerfen">
      <bpmn:documentation>Modellcode entwerfen. Synthetischer Übungsfall; Durchführung gemäß Fallbeschreibung, keine produktive Automatisierung.</bpmn:documentation>
      <bpmn:incoming>F6</bpmn:incoming>
      <bpmn:outgoing>F7</bpmn:outgoing>

    </bpmn:serviceTask>
    <bpmn:userTask id="CodePruefen" name="Code prüfen und korrigieren">
      <bpmn:documentation>Code prüfen und korrigieren. Synthetischer Übungsfall; Durchführung gemäß Fallbeschreibung, keine produktive Automatisierung.</bpmn:documentation>
      <bpmn:incoming>F7</bpmn:incoming>
      <bpmn:outgoing>F8</bpmn:outgoing>

    </bpmn:userTask>
    <bpmn:serviceTask id="Auswerten" name="Modell und Referenz auswerten">
      <bpmn:documentation>Modell und Referenz auswerten. Synthetischer Übungsfall; Durchführung gemäß Fallbeschreibung, keine produktive Automatisierung.</bpmn:documentation>
      <bpmn:incoming>F8</bpmn:incoming>
      <bpmn:outgoing>F9</bpmn:outgoing>

    </bpmn:serviceTask>
    <bpmn:userTask id="Bewerten" name="Eignung bewerten und entscheiden">
      <bpmn:documentation>Eignung bewerten und entscheiden. Synthetischer Übungsfall; Durchführung gemäß Fallbeschreibung, keine produktive Automatisierung.</bpmn:documentation>
      <bpmn:incoming>F9</bpmn:incoming>
      <bpmn:outgoing>F10</bpmn:outgoing>

      <bpmn:dataOutputAssociation id="A3"><bpmn:targetRef>Bewertung</bpmn:targetRef></bpmn:dataOutputAssociation>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="Eignung" name="Für Pilot geeignet?">
      <bpmn:incoming>F10</bpmn:incoming>
      <bpmn:outgoing>F11</bpmn:outgoing>
      <bpmn:outgoing>F12</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="Revision" name="Überarbeitung beurteilen">
      <bpmn:documentation>Überarbeitung beurteilen. Synthetischer Übungsfall; Durchführung gemäß Fallbeschreibung, keine produktive Automatisierung.</bpmn:documentation>
      <bpmn:incoming>F11</bpmn:incoming>
      <bpmn:outgoing>F13</bpmn:outgoing>

    </bpmn:userTask>
    <bpmn:exclusiveGateway id="Weiter" name="Überarbeitung sinnvoll?">
      <bpmn:incoming>F13</bpmn:incoming>
      <bpmn:outgoing>F14</bpmn:outgoing>
      <bpmn:outgoing>F15</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sendTask id="Abbruch" name="Abbruch begründen und mitteilen">
      <bpmn:documentation>Abbruch begründen und mitteilen. Synthetischer Übungsfall; Durchführung gemäß Fallbeschreibung, keine produktive Automatisierung.</bpmn:documentation>
      <bpmn:incoming>F15</bpmn:incoming>
      <bpmn:outgoing>F16</bpmn:outgoing>

    </bpmn:sendTask>
    <bpmn:endEvent id="EndeAbbruch" name="Ohne Freigabe beendet">
      <bpmn:incoming>F16</bpmn:incoming>

    </bpmn:endEvent>
    <bpmn:userTask id="Bericht" name="Pilotbericht erstellen">
      <bpmn:documentation>Pilotbericht erstellen. Synthetischer Übungsfall; Durchführung gemäß Fallbeschreibung, keine produktive Automatisierung.</bpmn:documentation>
      <bpmn:incoming>F12</bpmn:incoming>
      <bpmn:outgoing>F17</bpmn:outgoing>

    </bpmn:userTask>
    <bpmn:parallelGateway id="Split">
      <bpmn:incoming>F17</bpmn:incoming>
      <bpmn:outgoing>F18</bpmn:outgoing>
      <bpmn:outgoing>F19</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:sendTask id="Senden" name="Pilotbericht versenden">
      <bpmn:documentation>Pilotbericht versenden. Synthetischer Übungsfall; Durchführung gemäß Fallbeschreibung, keine produktive Automatisierung.</bpmn:documentation>
      <bpmn:incoming>F18</bpmn:incoming>
      <bpmn:outgoing>F20</bpmn:outgoing>

    </bpmn:sendTask>
    <bpmn:serviceTask id="Archiv" name="Arbeitsstand archivieren">
      <bpmn:documentation>Arbeitsstand archivieren. Synthetischer Übungsfall; Durchführung gemäß Fallbeschreibung, keine produktive Automatisierung.</bpmn:documentation>
      <bpmn:incoming>F19</bpmn:incoming>
      <bpmn:outgoing>F21</bpmn:outgoing>

      <bpmn:dataOutputAssociation id="A4"><bpmn:targetRef>Speicher</bpmn:targetRef></bpmn:dataOutputAssociation>
    </bpmn:serviceTask>
    <bpmn:parallelGateway id="Join">
      <bpmn:incoming>F20</bpmn:incoming>
      <bpmn:incoming>F21</bpmn:incoming>
      <bpmn:outgoing>F22</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:endEvent id="Ende" name="Übergeben und archiviert">
      <bpmn:incoming>F22</bpmn:incoming>

    </bpmn:endEvent>
    <bpmn:sequenceFlow id="F1" sourceRef="Start" targetRef="Frage" />
    <bpmn:sequenceFlow id="F2" sourceRef="Frage" targetRef="Daten" />
    <bpmn:sequenceFlow id="F3" sourceRef="Daten" targetRef="DatenOK" />
    <bpmn:sequenceFlow id="F4" name="nein" sourceRef="DatenOK" targetRef="EndeDaten" />
    <bpmn:sequenceFlow id="F5" name="ja" sourceRef="DatenOK" targetRef="Vorbereiten" />
    <bpmn:sequenceFlow id="F6" sourceRef="Vorbereiten" targetRef="Code" />
    <bpmn:sequenceFlow id="F7" sourceRef="Code" targetRef="CodePruefen" />
    <bpmn:sequenceFlow id="F8" sourceRef="CodePruefen" targetRef="Auswerten" />
    <bpmn:sequenceFlow id="F9" sourceRef="Auswerten" targetRef="Bewerten" />
    <bpmn:sequenceFlow id="F10" sourceRef="Bewerten" targetRef="Eignung" />
    <bpmn:sequenceFlow id="F11" name="nein" sourceRef="Eignung" targetRef="Revision" />
    <bpmn:sequenceFlow id="F12" name="ja" sourceRef="Eignung" targetRef="Bericht" />
    <bpmn:sequenceFlow id="F13" sourceRef="Revision" targetRef="Weiter" />
    <bpmn:sequenceFlow id="F14" name="ja" sourceRef="Weiter" targetRef="Vorbereiten" />
    <bpmn:sequenceFlow id="F15" name="nein" sourceRef="Weiter" targetRef="Abbruch" />
    <bpmn:sequenceFlow id="F16" sourceRef="Abbruch" targetRef="EndeAbbruch" />
    <bpmn:sequenceFlow id="F17" sourceRef="Bericht" targetRef="Split" />
    <bpmn:sequenceFlow id="F18" sourceRef="Split" targetRef="Senden" />
    <bpmn:sequenceFlow id="F19" sourceRef="Split" targetRef="Archiv" />
    <bpmn:sequenceFlow id="F20" sourceRef="Senden" targetRef="Join" />
    <bpmn:sequenceFlow id="F21" sourceRef="Archiv" targetRef="Join" />
    <bpmn:sequenceFlow id="F22" sourceRef="Join" targetRef="Ende" />
    <bpmn:dataObjectReference id="Auftrag" name="Auftragsblatt" dataObjectRef="DO_Auftrag" />
    <bpmn:dataObject id="DO_Auftrag" />
    <bpmn:dataObjectReference id="Paket" name="Datenpaket" dataObjectRef="DO_Paket" />
    <bpmn:dataObject id="DO_Paket" />
    <bpmn:dataObjectReference id="Bewertung" name="Bewertungsnotiz" dataObjectRef="DO_Bewertung" />
    <bpmn:dataObject id="DO_Bewertung" />
    <bpmn:dataStoreReference id="Speicher" name="Projektarchiv" />
  </bpmn:process>
