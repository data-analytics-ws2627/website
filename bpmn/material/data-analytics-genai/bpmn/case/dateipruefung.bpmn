<?xml version="1.0" encoding="UTF-8"?>
<!-- Synthetischer Übungsfall des Data-Analytics-Kurses. Fachliches Modell, nicht ausführbar. Getrennte Detailmodelle erläutern die zugeklappten Teilprozesse. -->
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_dateipruefung" targetNamespace="http://kirenz.de/data-analytics-genai" exporter="process-lab" exporterVersion="0.1">
  <bpmn:process id="Process_dateipruefung" name="Technische Prüfung einer einzelnen Datei" isExecutable="false">
    <bpmn:startEvent id="Start" name="Dateiprüfung begonnen">
      <bpmn:outgoing>F1</bpmn:outgoing>

    </bpmn:startEvent>
    <bpmn:parallelGateway id="Split">
      <bpmn:incoming>F1</bpmn:incoming>
      <bpmn:outgoing>F2</bpmn:outgoing>
      <bpmn:outgoing>F3</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:serviceTask id="Spalten" name="Erforderliche Spalten prüfen">
      <bpmn:documentation>Erforderliche Spalten prüfen. Synthetischer Übungsfall; Durchführung gemäß Fallbeschreibung, keine produktive Automatisierung.</bpmn:documentation>
      <bpmn:incoming>F2</bpmn:incoming>
      <bpmn:outgoing>F4</bpmn:outgoing>

    </bpmn:serviceTask>
    <bpmn:serviceTask id="Monat" name="Monatsformat prüfen">
      <bpmn:documentation>Monatsformat prüfen. Synthetischer Übungsfall; Durchführung gemäß Fallbeschreibung, keine produktive Automatisierung.</bpmn:documentation>
      <bpmn:incoming>F3</bpmn:incoming>
      <bpmn:outgoing>F5</bpmn:outgoing>

    </bpmn:serviceTask>
    <bpmn:parallelGateway id="Join">
      <bpmn:incoming>F4</bpmn:incoming>
      <bpmn:incoming>F5</bpmn:incoming>
      <bpmn:outgoing>F6</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:serviceTask id="Vermerk" name="Prüfvermerk erstellen">
      <bpmn:documentation>Prüfvermerk erstellen. Synthetischer Übungsfall; Durchführung gemäß Fallbeschreibung, keine produktive Automatisierung.</bpmn:documentation>
      <bpmn:incoming>F6</bpmn:incoming>
      <bpmn:outgoing>F7</bpmn:outgoing>

      <bpmn:dataOutputAssociation id="A1"><bpmn:targetRef>VermerkDatei</bpmn:targetRef></bpmn:dataOutputAssociation>
    </bpmn:serviceTask>
    <bpmn:endEvent id="Ende" name="Dateiprüfung abgeschlossen">
      <bpmn:incoming>F7</bpmn:incoming>

    </bpmn:endEvent>
    <bpmn:sequenceFlow id="F1" sourceRef="Start" targetRef="Split" />
    <bpmn:sequenceFlow id="F2" sourceRef="Split" targetRef="Spalten" />
    <bpmn:sequenceFlow id="F3" sourceRef="Split" targetRef="Monat" />
    <bpmn:sequenceFlow id="F4" sourceRef="Spalten" targetRef="Join" />
    <bpmn:sequenceFlow id="F5" sourceRef="Monat" targetRef="Join" />
    <bpmn:sequenceFlow id="F6" sourceRef="Join" targetRef="Vermerk" />
    <bpmn:sequenceFlow id="F7" sourceRef="Vermerk" targetRef="Ende" />
    <bpmn:dataObjectReference id="VermerkDatei" name="Dateiname und beide Prüfstatus" dataObjectRef="DO_VermerkDatei" />
    <bpmn:dataObject id="DO_VermerkDatei" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="Diagram_dateipruefung">
    <bpmndi:BPMNPlane id="Plane_dateipruefung" bpmnElement="Process_dateipruefung">
      <bpmndi:BPMNShape id="Start_di" bpmnElement="Start"><dc:Bounds x="72" y="212" width="36" height="36" /><bpmndi:BPMNLabel><dc:Bounds x="15" y="252" width="150" height="28" /></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Split_di" bpmnElement="Split" isMarkerVisible="true"><dc:Bounds x="205" y="205" width="50" height="50" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Spalten_di" bpmnElement="Spalten"><dc:Bounds x="380" y="60" width="140" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Monat_di" bpmnElement="Monat"><dc:Bounds x="380" y="320" width="140" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Join_di" bpmnElement="Join" isMarkerVisible="true"><dc:Bounds x="645" y="205" width="50" height="50" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Vermerk_di" bpmnElement="Vermerk"><dc:Bounds x="790" y="190" width="140" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Ende_di" bpmnElement="Ende"><dc:Bounds x="1032" y="212" width="36" height="36" /><bpmndi:BPMNLabel><dc:Bounds x="965" y="252" width="170" height="28" /></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="F1_di" bpmnElement="F1"><di:waypoint x="108" y="230" /><di:waypoint x="205" y="230" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F2_di" bpmnElement="F2"><di:waypoint x="230" y="205" /><di:waypoint x="230" y="100" /><di:waypoint x="380" y="100" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F3_di" bpmnElement="F3"><di:waypoint x="230" y="255" /><di:waypoint x="230" y="360" /><di:waypoint x="380" y="360" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F4_di" bpmnElement="F4"><di:waypoint x="520" y="100" /><di:waypoint x="670" y="100" /><di:waypoint x="670" y="205" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F5_di" bpmnElement="F5"><di:waypoint x="520" y="360" /><di:waypoint x="670" y="360" /><di:waypoint x="670" y="255" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F6_di" bpmnElement="F6"><di:waypoint x="695" y="230" /><di:waypoint x="790" y="230" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F7_di" bpmnElement="F7"><di:waypoint x="930" y="230" /><di:waypoint x="1032" y="230" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNShape id="VermerkDatei_di" bpmnElement="VermerkDatei"><dc:Bounds x="842" y="365" width="36" height="50" /><bpmndi:BPMNLabel><dc:Bounds x="810" y="419" width="100" height="28" /></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="A1_di" bpmnElement="A1"><di:waypoint x="860" y="270" /><di:waypoint x="860" y="365" /></bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
